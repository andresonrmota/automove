/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.eslintcache

# =========================================
# 2. NEXT.JS & WEB BUILD
# =========================================
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
.vercel

# =========================================
# 3. ELECTRON DESKTOP BUILD (CRÍTICO)
# =========================================
/dist/
/dist-electron/
/release/

# =========================================
# 4. SEGURANÇA E AMBIENTE
# =========================================
.env*
*.pem
/data/config.json

# =========================================
# 5. PLAYWRIGHT E TESTES
# =========================================
/coverage
test-results/
error_*.png
playwright-report/
blob-report/

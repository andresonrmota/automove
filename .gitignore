/uploads/
/Triados/
/Processados/
*.pdf
*.jpg
*.jpeg
*.png

# =========================================
# 7. LOGS E SISTEMA OPERACIONAL
# =========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db

# Exceção explícita para garantir o versionamento do arquivo de instruções
!INSTRUCOES_DE_BUILD.md

# baseline (sync antes da troca de Mac)
node_modules/
.env
.env.*
!.env.example
__pycache__/
